# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=finmesh
POSTGRES_USER=finmesh
POSTGRES_PASSWORD=finmesh

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=finmesh
CLICKHOUSE_PASSWORD=finmesh
CLICKHOUSE_DATABASE=finmesh

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=finmesh-events

# FinMesh Intelligence
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol